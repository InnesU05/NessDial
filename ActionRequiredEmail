<!DOCTYPE html>
<html>
<head>
<style>
  /* Responsive Mobile Styles */
  @media only screen and (max-width: 600px) {
    .main-table { width: 100% !important; }
    .mobile-pad { padding: 20px !important; }
  }
</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">

  <table class="main-table" border="0" cellpadding="0" cellspacing="0" width="600" style="margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
    
    <tr>
      <td bgcolor="#005EB8" style="padding: 30px; text-align: center;">
        <img src="https://nessdial.co.uk/logo.png" alt="NessDial" width="80" style="background-color: white; border-radius: 8px; padding: 5px; display: block; margin: 0 auto;">
      </td>
    </tr>

    <tr>
      <td class="mobile-pad" style="padding: 40px 50px;">
        <h1 style="color: #0B1C3E; font-size: 24px; margin-top: 0;">Hi {{firstName}},</h1>
        
        <p style="color: #4b5563; font-size: 16px; line-height: 1.6;">
          Thanks for choosing <strong>NessDial</strong>. We have successfully received your request for a <strong>{{selectedTier}}</strong> AI agent.
        </p>

        <table width="100%" bgcolor="#eff6ff" cellpadding="20" style="border-radius: 8px; border-left: 5px solid #005EB8; margin: 25px 0;">
          <tr>
            <td>
              <p style="margin: 0; color: #1e3a8a; font-weight: bold; font-size: 14px; text-transform: uppercase;">Next Step: Activation</p>
              <p style="margin: 5px 0 0 0; color: #1e40af; font-size: 15px;">
                We build every agent manually to ensure quality. To start this process, please activate your subscription below.
              </p>
            </td>
          </tr>
        </table>

        <div style="text-align: center; margin: 35px 0;">
          <a href="{{paymentLink}}" style="background-color: #005EB8; color: #ffffff; padding: 16px 32px; border-radius: 50px; text-decoration: none; font-weight: bold; font-size: 16px; display: inline-block;">
            Complete Secure Checkout &rarr;
          </a>
        </div>

        <p style="color: #6b7280; font-size: 14px; line-height: 1.5;">
          <strong>What happens next?</strong><br>
          Once payment is confirmed, we aim to have your agent live within <strong>24 hours</strong>. You will receive a receipt immediately after payment.
        </p>

        <hr style="border: 0; border-top: 1px solid #e5e7eb; margin: 30px 0;">

        <p style="color: #9ca3af; font-size: 12px; margin-bottom: 5px;">
          <strong>Cancellation Policy:</strong> This is a rolling monthly subscription. To cancel, simply email us at <a href="mailto:nessdialai@gmail.com" style="color: #005EB8;">nessdialai@gmail.com</a>.
        </p>
        <p style="color: #9ca3af; font-size: 12px; font-style: italic;">
          This is an automated message from the NessDial Registration System.
        </p>
      </td>
    </tr>

    <tr>
      <td bgcolor="#0B1C3E" style="padding: 20px; text-align: center; color: #9ca3af; font-size: 12px;">
        <p style="margin: 0;">&copy; 2024 NessDial. Built in Scotland.</p>
        <p style="margin: 5px 0 0 0;">Aberdeen, United Kingdom | 07986 019065</p>
      </td>
    </tr>
  </table>

</body>
</html>